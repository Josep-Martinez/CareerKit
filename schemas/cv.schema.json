{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerkit.invalid/schemas/cv.schema.json",
  "title": "CareerKit CV versions",
  "type": "object",
  "required": ["schemaVersion", "versions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "versions": {
      "type": "object",
      "required": ["spanish", "english"],
      "properties": {
        "spanish": { "$ref": "#/$defs/version" },
        "english": { "$ref": "#/$defs/version" }
      },
      "additionalProperties": true
    },
    "previousVersion": { "$ref": "#/$defs/version" }
  },
  "additionalProperties": true,
  "$defs": {
    "version": {
      "type": "object",
      "required": ["masterText", "lastUpdated", "lastReviewed"],
      "properties": {
        "masterText": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "lastReviewed": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
