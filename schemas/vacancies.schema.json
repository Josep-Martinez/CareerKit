{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerkit.invalid/schemas/vacancies.schema.json",
  "title": "CareerKit vacancies",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "company": { "type": "string" },
          "location": { "type": "string" },
          "modality": { "type": "string" },
          "link": { "type": "string" },
          "source": { "type": "string" },
          "searchedAt": { "type": "string" },
          "verifiedAt": { "type": "string" },
          "description": { "type": "string" },
          "salary": { "type": "string" },
          "salaryVerified": { "type": "boolean" },
          "level": { "type": "string" },
          "jobType": { "type": "string" },
          "assessment": { "type": "string" },
          "matchingEvidenceIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "gaps": { "type": "string" },
          "blockers": { "type": "string" },
          "preference": { "type": "integer" },
          "featured": { "type": "boolean" },
          "availability": { "$ref": "#/$defs/availability" },
          "hiringContact": { "$ref": "#/$defs/hiringContact" },
          "cvAdvice": { "$ref": "#/$defs/cvAdvice" },
          "adaptedCv": { "$ref": "#/$defs/adaptedCv" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "availability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["active", "closed", "uncertain"] },
        "checkedAt": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hiringContact": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "contactUrl": { "type": "string" },
        "publicEmail": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "adaptedCv": {
      "type": "object",
      "required": ["text", "language"],
      "properties": {
        "text": { "type": "string", "pattern": "\\S" },
        "language": { "enum": ["es", "en"] },
        "layout": { "enum": ["single-column", "two-columns"] }
      },
      "additionalProperties": true
    },
    "cvAdvice": {
      "type": "object",
      "required": [
        "recommendedVersion",
        "reason",
        "assessedAt",
        "spanishAdjustments",
        "englishAdjustments"
      ],
      "properties": {
        "recommendedVersion": {
          "enum": ["spanish", "english", "both", "pending"]
        },
        "reason": { "type": "string" },
        "assessedAt": { "type": "string" },
        "spanishAdjustments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "englishAdjustments": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
