{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerkit.invalid/schemas/linkedin.schema.json",
  "title": "CareerKit LinkedIn snapshot and audit notes",
  "type": "object",
  "required": ["schemaVersion", "published", "audits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lastUpdated": { "type": "string" },
    "published": {
      "type": "object",
      "required": [
        "headline",
        "about",
        "experience",
        "education",
        "skills",
        "certifications",
        "projects",
        "featured"
      ],
      "properties": {
        "name": { "type": "string" },
        "headline": { "type": "string" },
        "about": { "type": "string" },
        "experience": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "#/$defs/experienceEntry" }
            ]
          }
        },
        "education": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "#/$defs/educationEntry" }
            ]
          }
        },
        "languages": {
          "description": "Languages listed as profile content. This is not a profile translation or localized version.",
          "type": "array",
          "items": {
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/languageEntry" }]
          }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "certifications": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "#/$defs/certificationEntry" }
            ]
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/projectEntry" }]
          }
        },
        "featured": {
          "type": "array",
          "items": {
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/featuredEntry" }]
          }
        },
        "additionalSections": {
          "description": "Published LinkedIn sections that do not fit one of the standard fields. Preserve their original heading and complete visible content.",
          "type": "array",
          "items": { "$ref": "#/$defs/additionalSection" }
        },
        "variants": {
          "description": "Additional public snapshots in explicitly recorded languages. Each item is independent; do not assume or translate the main snapshot.",
          "type": "array",
          "items": { "$ref": "#/$defs/localizedProfile" }
        }
      },
      "additionalProperties": true
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "section",
          "priority",
          "problem",
          "reasonEvidence",
          "recommendation",
          "proposedText",
          "date",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "section": { "type": "string" },
          "sectionId": {
            "description": "Stable ID of the published additional section this audit note targets, when section is additionalSections.",
            "type": "string",
            "minLength": 1
          },
          "sectionLabel": {
            "description": "Last known title of the additional section, retained so an audit remains understandable if that section is removed.",
            "type": "string"
          },
          "variantId": {
            "description": "Stable ID of the localized published profile this audit targets. Omit for the main published profile.",
            "type": "string",
            "minLength": 1
          },
          "targetEntryId": {
            "description": "Stable ID of the exact published list entry targeted by proposedText, when available.",
            "type": "string",
            "minLength": 1
          },
          "targetEntryIndex": {
            "description": "Zero-based index of the exact published list entry targeted by proposedText when that entry has no stable ID.",
            "type": "integer",
            "minimum": 0
          },
          "targetField": {
            "description": "Exact text field targeted by proposedText. Use value for a plain string item.",
            "type": "string",
            "minLength": 1
          },
          "action": { "enum": ["corregir", "anadir", "aclarar"] },
          "priority": { "enum": ["alta", "media", "baja"] },
          "problem": { "type": "string" },
          "reasonEvidence": { "type": "string" },
          "profileEvidenceIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommendation": { "type": "string" },
          "proposedText": { "type": "string" },
          "date": { "type": "string" },
          "status": { "enum": ["pendiente", "aplicada", "descartada"] }
        },
        "allOf": [
          {
            "if": { "required": ["sectionId"] },
            "then": {
              "properties": { "section": { "const": "additionalSections" } }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "localizedProfile": {
      "type": "object",
      "required": [
        "id",
        "language",
        "headline",
        "about",
        "experience",
        "education",
        "skills",
        "certifications",
        "projects",
        "featured"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "lastUpdated": { "type": "string" },
        "name": { "type": "string" },
        "headline": { "type": "string" },
        "about": { "type": "string" },
        "experience": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "#/$defs/experienceEntry" }
            ]
          }
        },
        "education": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "#/$defs/educationEntry" }
            ]
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/languageEntry" }]
          }
        },
        "skills": { "type": "array", "items": { "type": "string" } },
        "certifications": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "#/$defs/certificationEntry" }
            ]
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/projectEntry" }]
          }
        },
        "featured": {
          "type": "array",
          "items": {
            "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/featuredEntry" }]
          }
        },
        "additionalSections": {
          "type": "array",
          "items": { "$ref": "#/$defs/additionalSection" }
        }
      },
      "additionalProperties": true
    },
    "experienceEntry": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "employmentType": { "type": "string" },
        "location": { "type": "string" },
        "workplaceType": { "type": "string" },
        "dates": { "type": "string" },
        "description": { "type": "string" },
        "descriptionTruncated": { "type": "boolean" },
        "skills": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "educationEntry": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string" },
        "institution": { "type": "string" },
        "degree": { "type": "string" },
        "fieldOfStudy": { "type": "string" },
        "dates": { "type": "string" },
        "grade": { "type": "string" },
        "activities": { "type": "string" },
        "description": { "type": "string" },
        "descriptionTruncated": { "type": "boolean" },
        "skills": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "languageEntry": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string" },
        "language": { "type": "string" },
        "proficiency": { "type": "string" },
        "details": { "type": "string" }
      },
      "additionalProperties": true
    },
    "certificationEntry": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "issueDate": { "type": "string" },
        "expirationDate": { "type": "string" },
        "credentialId": { "type": "string" },
        "credentialUrl": { "type": "string" },
        "description": { "type": "string" },
        "descriptionTruncated": { "type": "boolean" },
        "skills": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "projectEntry": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "associatedWith": { "type": "string" },
        "dates": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "descriptionTruncated": { "type": "boolean" },
        "skills": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "featuredEntry": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "mediaType": { "type": "string" },
        "descriptionTruncated": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "additionalSection": {
      "type": "object",
      "required": ["id", "title", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "content": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
