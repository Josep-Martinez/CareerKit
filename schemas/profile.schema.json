{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerkit.invalid/schemas/profile.schema.json",
  "title": "CareerKit profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "professionalProfile",
    "objectives",
    "skills",
    "experience",
    "education",
    "certifications",
    "languages",
    "projects",
    "evidence",
    "learnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "professionalProfile": { "type": "string" },
    "personalContext": { "$ref": "#/$defs/personalContext" },
    "careerPreferences": { "$ref": "#/$defs/careerPreferences" },
    "contentDirection": { "$ref": "#/$defs/contentDirection" },
    "objectives": {
      "type": "object",
      "required": ["shortTerm", "mediumTerm", "longTerm"],
      "properties": {
        "shortTerm": { "type": "string" },
        "mediumTerm": { "type": "string" },
        "longTerm": { "type": "string" }
      },
      "additionalProperties": true
    },
    "skills": { "$ref": "#/$defs/entries" },
    "experience": { "$ref": "#/$defs/entries" },
    "education": { "$ref": "#/$defs/entries" },
    "certifications": { "$ref": "#/$defs/entries" },
    "languages": { "$ref": "#/$defs/entries" },
    "projects": { "$ref": "#/$defs/entries" },
    "evidence": { "$ref": "#/$defs/entries" },
    "learnings": { "$ref": "#/$defs/entries" }
  },
  "additionalProperties": true,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "personalContext": {
      "type": "object",
      "properties": {
        "aboutMe": { "type": "string" },
        "values": { "$ref": "#/$defs/stringList" },
        "interests": { "$ref": "#/$defs/stringList" },
        "motivations": { "type": "string" },
        "thinkingStyle": { "type": "string" },
        "learningStyle": { "type": "string" },
        "workStyle": { "type": "string" },
        "strengths": { "$ref": "#/$defs/stringList" },
        "growthAreas": { "$ref": "#/$defs/stringList" },
        "preferredEnvironment": { "type": "string" },
        "boundaries": { "type": "string" }
      },
      "additionalProperties": true
    },
    "careerPreferences": {
      "type": "object",
      "properties": {
        "roleFamilies": { "$ref": "#/$defs/stringList" },
        "tasks": { "$ref": "#/$defs/stringList" },
        "industries": { "$ref": "#/$defs/stringList" },
        "workModes": { "$ref": "#/$defs/stringList" },
        "location": { "type": "string" },
        "conditions": { "type": "string" },
        "avoid": { "$ref": "#/$defs/stringList" },
        "internal": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "contentDirection": {
      "type": "object",
      "properties": {
        "themes": { "$ref": "#/$defs/stringList" },
        "viewpoints": { "$ref": "#/$defs/stringList" },
        "tone": { "type": "string" },
        "avoid": { "$ref": "#/$defs/stringList" },
        "languages": { "$ref": "#/$defs/stringList" },
        "versionPreference": { "type": "string" },
        "internal": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "name": { "type": "string" },
          "organization": { "type": "string" },
          "dates": { "type": "string" },
          "actions": { "type": "string" },
          "results": { "type": "string" },
          "description": { "type": "string" },
          "grade": { "type": "string" },
          "status": { "type": "string" },
          "proficiency": { "type": "string" },
          "situation": { "type": "string" },
          "task": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "confirmed": { "type": "boolean" },
          "cvEvidence": { "type": "boolean" },
          "onLinkedIn": { "type": "boolean" },
          "internal": { "type": "boolean" },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  }
}
