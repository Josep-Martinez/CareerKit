{
  "name": "careerkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "local": "vite",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"schemas/**/*.json\" \"templates/**/*.json\" \"package.json\" \"vite.config.js\" \"index.html\" \".github/**/*.{yml,yaml}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"schemas/**/*.json\" \"templates/**/*.json\" \"package.json\" \"vite.config.js\" \"index.html\" \".github/**/*.{yml,yaml}\" \".prettierrc.json\"",
    "test": "node --test",
    "pages:prepare": "node scripts/prepare-github-pages.mjs",
    "preview": "vite preview",
    "check:publish": "node scripts/check-publish.mjs",
    "data:init": "node scripts/initialize-private-data.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
